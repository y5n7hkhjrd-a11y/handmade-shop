generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  Admin
  Staff
}

enum ProductType {
  BASE
  CHARM
}

enum OrderStatus {
  Draft
  WaitingConfirm
  InProgress
  Packaging
  ReadyToShip
  Completed
}

enum OrderLineType {
  RECIPE
  PRODUCT
}

enum TransactionType {
  IMPORT
  SALE
  ADJUSTMENT
}

enum ShippingStatus {
  Pending
  Shipped
  InTransit
  Delivered
  Failed
}

enum PackagingType {
  ITEM
  ORDER
}

model MatchingRule {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  pattern     String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  recipeProducts RecipeProduct[]

  @@map("matching_rules")
}

model User {
  id        String    @id @default(uuid()) @db.Uuid
  username  String    @unique
  email     String?
  password  String
  name      String
  role      UserRole  @default(Staff)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("users")
}

model Customer {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  email     String    @unique
  phone     String?
  address   String?
  facebook  String?
  instagram String?
  tiktok    String?
  threads   String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  orders Order[]

  @@map("customers")
}

model Product {
  id              String      @id @default(uuid()) @db.Uuid
  type            ProductType
  name            String
  description     String?
  cost            Decimal     @default(0) @db.Decimal(12, 2)
  isActive        Boolean     @default(true) @map("is_active")
  trackInventory  Boolean     @default(true) @map("track_inventory")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  orderItems   OrderItem[]
  orderLines   OrderLine[]
  costRules    CostRule[]
  transactions InventoryTransaction[]
  recipeOf     RecipeProduct[]

  @@map("products")
}

model Recipe {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  recipeProducts  RecipeProduct[]
  orders          Order[]
  orderLines      OrderLine[]

  @@map("recipes")
}

model RecipeProduct {
  id              String        @id @default(uuid()) @db.Uuid
  recipeId        String        @map("recipe_id") @db.Uuid
  productId       String        @map("product_id") @db.Uuid
  matchingRuleId  String?       @map("matching_rule_id") @db.Uuid
  quantity        Int           @default(1)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  recipe  Recipe       @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id])
  matchingRule MatchingRule? @relation(fields: [matchingRuleId], references: [id])

  @@unique([recipeId, productId])
  @@map("recipe_products")
}

model PackagingTemplate {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  type        PackagingType
  description String?
  totalCost   Decimal       @default(0) @map("total_cost") @db.Decimal(12, 2)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  components  PackagingComponent[]
  orderItems  OrderItem[]
  orderLines  OrderLine[]

  @@map("packaging_templates")
}

model PackagingComponent {
  id                  String   @id @default(uuid()) @db.Uuid
  packagingTemplateId String   @map("packaging_template_id") @db.Uuid
  name                String
  quantity            Decimal  @db.Decimal(12, 4)
  unit                String
  cost                Decimal  @db.Decimal(12, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?

  packagingTemplate PackagingTemplate @relation(fields: [packagingTemplateId], references: [id], onDelete: Cascade)

  @@map("packaging_components")
}

model OrderSequence {
  date    String @id
  counter Int

  @@map("order_sequences")
}

model Order {
  id              String      @id
  customerId      String      @map("customer_id") @db.Uuid
  status          OrderStatus @default(Draft)
  orderDate       DateTime    @default(now()) @map("order_date")
  deadline        DateTime?   @map("deadline")
  confirmedAt     DateTime?   @map("confirmed_at")
  packagedAt      DateTime?   @map("packaged_at")
  sentAt          DateTime?   @map("sent_at")
  completedAt     DateTime?   @map("completed_at")
  recipeId        String?     @map("recipe_id") @db.Uuid
  customInput     String?     @map("custom_input")
  subtotal        Decimal     @default(0) @db.Decimal(12, 2)
  discount        Decimal     @default(0) @db.Decimal(12, 2)
  paidAmount      Decimal     @default(0) @map("paid_amount") @db.Decimal(12, 2)
  materialCost    Decimal     @default(0) @map("material_cost") @db.Decimal(12, 2)
  packagingCost   Decimal     @default(0) @map("packaging_cost") @db.Decimal(12, 2)
  shippingCost    Decimal     @default(0) @map("shipping_cost") @db.Decimal(12, 2)
  shippingPaidBy  String?     @default("prepaid") @map("shipping_paid_by")
  totalCost       Decimal     @default(0) @map("total_cost") @db.Decimal(12, 2)
  salePriceSnapshot  Decimal? @map("sale_price_snapshot") @db.Decimal(12, 2)
  costSnapshot       Decimal? @map("cost_snapshot") @db.Decimal(12, 2)
  recipeSnapshot     Json?    @map("recipe_snapshot")
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  customer Customer      @relation(fields: [customerId], references: [id])
  recipe   Recipe?       @relation(fields: [recipeId], references: [id])
  items    OrderItem[]
  orderLines OrderLine[]
  shipping Shipping[]

  @@map("orders")
}

model OrderLine {
  id          String        @id @default(uuid()) @db.Uuid
  orderId     String        @map("order_id")
  type        OrderLineType
  // Recipe type fields
  recipeId    String?       @map("recipe_id") @db.Uuid
  customInput String?       @map("custom_input")
  salePrice   Decimal?      @map("sale_price") @db.Decimal(12, 2)
  // Product type fields
  productId   String?       @map("product_id") @db.Uuid
  quantity    Int?          @default(1)
  unitPrice   Decimal?      @map("unit_price") @db.Decimal(12, 2)
  packagingTemplateId String? @map("packaging_template_id") @db.Uuid
  // Common
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  recipe            Recipe?            @relation(fields: [recipeId], references: [id])
  product           Product?           @relation(fields: [productId], references: [id])
  packagingTemplate PackagingTemplate? @relation(fields: [packagingTemplateId], references: [id])

  @@map("order_lines")
}

model OrderItem {
  id                 String   @id @default(uuid()) @db.Uuid
  orderId            String   @map("order_id")
  productId          String   @map("product_id") @db.Uuid
  quantity           Int      @default(1)
  unitPrice          Decimal  @map("unit_price") @db.Decimal(12, 2)
  totalPrice         Decimal  @map("total_price") @db.Decimal(12, 2)
  packagingTemplateId String? @map("packaging_template_id") @db.Uuid
  packagingCost      Decimal  @default(0) @map("packaging_cost") @db.Decimal(12, 2)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product            @relation(fields: [productId], references: [id])
  packagingTemplate PackagingTemplate? @relation(fields: [packagingTemplateId], references: [id])

  @@map("order_items")
}

model InventoryTransaction {
  id             String          @id @default(uuid()) @db.Uuid
  type           TransactionType
  productId      String?         @map("product_id") @db.Uuid
  componentName  String?         @map("component_name")
  quantity       Decimal         @db.Decimal(12, 4)
  unit           String          @default("unit")
  reference      String?
  notes          String?
  createdAt      DateTime        @default(now())
  deletedAt      DateTime?

  product Product? @relation(fields: [productId], references: [id])

  @@map("inventory_transactions")
}

model CostRule {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  productType ProductType @map("product_type")
  formula     Json
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  productId String? @map("product_id") @db.Uuid
  product   Product? @relation(fields: [productId], references: [id])

  @@map("cost_rules")
}

model Shipping {
  id              String         @id @default(uuid()) @db.Uuid
  orderId         String         @map("order_id")
  deliveryType    String         @map("delivery_type")
  shippingMethod  String         @map("shipping_method")
  carrier         String?
  trackingNumber  String?        @map("tracking_number")
  trackingUrl     String?        @map("tracking_url")
  driverName      String?        @map("driver_name")
  driverPhone     String?        @map("driver_phone")
  status          ShippingStatus @default(Pending)
  eta             DateTime?
  cost            Decimal        @default(0) @db.Decimal(12, 2)
  shippedAt       DateTime?      @map("shipped_at")
  deliveredAt     DateTime?      @map("delivered_at")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  order Order @relation(fields: [orderId], references: [id])

  @@map("shippings")
}
