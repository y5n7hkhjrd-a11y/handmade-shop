# =============================================================================
# Environment Variables — [TEMPLATE]
# =============================================================================
# Copy this file to .env and replace placeholders with real values.
# NEVER commit real secrets to git.

# ── Database ────────────────────────────────────────────────────────────
# Local development (Docker):
# DATABASE_URL="postgresql://handmade_shop:handmade_shop_dev@localhost:5432/handmade_shop"

# Supabase staging (replace XXXXX with your actual Supabase project ref):
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.XXXXXXX.supabase.co:6543/postgres?pgbouncer=true&connect_timeout=15"

# Neon staging (recommended in docs):
# DATABASE_URL="postgresql://user:password@ep-xxxxx.us-east-1.aws.neon.tech/neondb?pgbouncer=true&connect_timeout=15"

# ⚠️  PICK ONE and replace with YOUR actual connection string:
DATABASE_URL="postgresql://postgres:REPLACE_WITH_YOUR_PASSWORD@db.REPLACE_WITH_YOUR_PROJECT_REF.supabase.co:6543/postgres?pgbouncer=true&connect_timeout=15"

# Direct connection (port 5432, no pooler) — for running migrations & seeds.
# CircleCI uses *_DIRECT variants for the `prisma migrate deploy` step.
# DATABASE_URL_DIRECT="postgresql://postgres:YOUR_PASSWORD@db.XXXXXXX.supabase.co:5432/postgres"

# ── JWT ─────────────────────────────────────────────────────────────────
JWT_SECRET="change-this-to-a-secure-random-string"
JWT_EXPIRES_IN="7d"

# ── App ─────────────────────────────────────────────────────────────────
API_PORT=4000
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
