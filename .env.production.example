# =============================================================================
# Handmade Shop — PRODUCTION Environment Variables
# =============================================================================
# Copy this file to .env.production and fill in the values.
# These vars are injected by CircleCI during the production workflow.
#
# Vercel project IDs are obtained by running:
#   vercel project ls
# Then linking each project:
#   cd apps/web && vercel link
#   cd apps/api && vercel link
# The project and org IDs appear in .vercel/project.json after linking.
# =============================================================================

# --------------------------------
# Database
# --------------------------------
# For Supabase: use port 6543 (PgBouncer pooled) with ?pgbouncer=true
# For Neon: use pooled URL (includes ?pgbouncer=true by default)
DATABASE_URL="postgresql://user:password@production-host:6543/handmade_shop_production?pgbouncer=true&connect_timeout=15"

# --------------------------------
# JWT Authentication
# --------------------------------
JWT_SECRET="change-this-to-a-production-secret-key"
JWT_EXPIRES_IN="7d"

# --------------------------------
# App
# --------------------------------
API_PORT=4000
NEXT_PUBLIC_API_URL="https://api-production-your-project.vercel.app/api"

# --------------------------------
# Vercel
# --------------------------------
VERCEL_ORG_ID="team_xxxxxxxxxxxxxxxxxxxxxxxx"
VERCEL_PROJECT_ID_WEB_PROD="prj_xxxxxxxxxxxxxxxxxxxxxxxx"
VERCEL_PROJECT_ID_API_PROD="prj_xxxxxxxxxxxxxxxxxxxxxxxx"
