{
  "name": "handmade-shop",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @handmade-shop/shared build && concurrently \"pnpm --filter @handmade-shop/api dev\" \"pnpm --filter @handmade-shop/web dev\"",
    "build": "pnpm --filter @handmade-shop/shared build && pnpm --filter @handmade-shop/api build && pnpm --filter @handmade-shop/web build",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @handmade-shop/api test && pnpm --filter @handmade-shop/web test",
    "test:api": "pnpm --filter @handmade-shop/api test",
    "test:web": "pnpm --filter @handmade-shop/web test",
    "db:migrate": "pnpm --filter @handmade-shop/api prisma:migrate",
    "db:seed": "pnpm --filter @handmade-shop/api prisma:seed",
    "db:studio": "pnpm --filter @handmade-shop/api prisma:studio",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,css,md}\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
